{
  "version": "0.2.0",
  "configurations": [
    {
      // Opens sandbox/workspace in a separate VS Code profile (sandbox/user-data) whose user
      // settings set "sessionFolders.claudeDir" to the absolute path of sandbox/claude, so
      // development never reads or writes your real ~/.claude. (The setting is user-only, so a
      // workspace settings file cannot do this.) sandbox/ is gitignored and never packaged.
      // Create it once: sandbox/claude/projects/ holds a few made-up sessions, and
      // sandbox/user-data/User/settings.json points claudeDir there.
      "name": "Run Extension (sandbox)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/sandbox/user-data",
        "${workspaceFolder}/sandbox/workspace"
      ]
    }
  ]
}
